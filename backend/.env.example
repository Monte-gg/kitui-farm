# Copy to backend/.env (never commit .env) and fill in the values.

# Local server
PORT=3000
DB_PATH=./data/kitui-farm.sqlite

# Supabase project (Dashboard -> Project Settings -> API)
# Use the secret key server-side only. Supabase is retiring the legacy
# service_role key, so this project expects the new sb_secret_... key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
