# Copy to backend/.env (never commit .env) and fill in the values.

# Local server
PORT=3000
DB_PATH=./data/kitui-farm.sqlite

# Supabase Postgres: Dashboard -> Project Settings -> Database -> Connection string -> URI
# This is the only Supabase value the API reads. The publishable/anon key is not used.
DATABASE_URL=

# Gmail SMTP signup verification. GMAIL_APP_PASSWORD is not your regular password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
PUBLIC_APP_URL=https://kitui-farm.onrender.com
