# Copy to backend/.env (never commit .env) and fill in the values.

# Local server
PORT=3000
DB_PATH=./data/kitui-farm.sqlite

# Supabase Postgres: Dashboard -> Project Settings -> Database -> Connection string -> URI
# This is the only Supabase value the API reads. The publishable/anon key is not used.
DATABASE_URL=

# Gmail API signup verification. Keep these OAuth secrets on the server only.
GMAIL_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
PUBLIC_APP_URL=https://monte-gg.github.io/kitui-farm

# --- Deposits: Safaricom Daraja STK Push -----------------------------------
# MPESA_ENV=sandbox uses sandbox.safaricom.co.ke, MPESA_ENV=live uses api.safaricom.co.ke.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random value of at least 32 characters; it is part of the callback URL.
MPESA_CALLBACK_SECRET=
# Public HTTPS base URL that Safaricom can reach, e.g. https://kitui-farm.onrender.com
# Render provides RENDER_EXTERNAL_URL automatically, so this can stay empty there.
MPESA_CALLBACK_BASE_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- Withdrawals: Safaricom Daraja B2C -------------------------------------
# DARAJA_ENV=sandbox or production. Production needs Safaricom's live B2C approval.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_SHORTCODE=
# Random value of at least 32 characters; it signs the B2C callback URLs.
DARAJA_CALLBACK_SECRET=
# true: pay withdrawals immediately. false: an administrator starts each payout.
DARAJA_AUTO_PAYOUT=false
